#!/bin/bash

LAUNCH_CMD_FILE="/var/kazeta/state/.LAUNCH_CMD"

# The guide daemon (kazeta-guided) runs in BOTH session types: over a game it
# offers return/home/power-off, over the dashboard the game rows grey out. It
# owns the Guide button via InputPlumber intercept + an X grab on Home, so the
# bios's built-in guide modal never fires while it runs. It waits for X itself
# and exits on its own when the session's compositor dies.
# NOTE: keep `wait "$BIOS_PID"` below — a bare `wait` would also wait on the
# daemon and hang game launches.

# If a game was selected from the BIOS, launch it in this self-contained block.
if [ -f "$LAUNCH_CMD_FILE" ]; then
    LAUNCH_CMD=$(cat "$LAUNCH_CMD_FILE")

    rm -f "$LAUNCH_CMD_FILE"

    # The dashboard's gamescope just exited to get here. Its DRM/seat teardown
    # is asynchronous and messy on this hardware (libseat "Could not close
    # device" in session.log) - starting the game's gamescope into that
    # half-released display wedges it on a black screen. Wait for the old
    # compositor to be fully gone, then give the kernel a moment.
    # (The compositor's process name is gamescope-wl, NOT gamescope.)
    for i in $(seq 1 25); do
        pgrep -x gamescope-wl >/dev/null || break
        sleep 0.2
    done
    sleep 1

    pkill -x kazeta-guided 2>/dev/null
    if [ -x /usr/bin/kazeta-guided ]; then
        DISPLAY=:0 /usr/bin/kazeta-guided >/dev/null 2>&1 &
        GUIDED_PID=$!
    fi

    # Run the game session script (logged - gamescope/game errors were
    # previously invisible because this ran outside any redirect).
    eval "$LAUNCH_CMD" >> /var/kazeta/launch.log 2>&1

    kill "$GUIDED_PID" 2>/dev/null

    # IMPORTANT: After the game quits, restart the entire session.
    # This will cause the script to run again from the top, where it will
    # then fall through to the BIOS Launch Section below.
    exec kazeta-session
fi

# -- BIOS Launch Section --
# This section is only reached on a fresh boot or after a session restart.

# Ensure inputplumber manages controllers.
for i in $(seq 1 100); do
    inputplumber devices manage-all --enable
    if [ "$?" == "0" ]; then break; fi
    sleep 0.1
done

# Hack to fix audio.
wpctl status > /dev/null

# Rotate the old log file.
if [ -f /var/kazeta/session.log ]; then
    mv /var/kazeta/session.log /var/kazeta/session.log.old
fi

# Launch the BIOS application in the background.
/usr/bin/kazeta > /var/kazeta/session.log 2>&1 &
BIOS_PID=$!

# Guide daemon for the dashboard session (kazeta home / return rows greyed).
pkill -x kazeta-guided 2>/dev/null
if [ -x /usr/bin/kazeta-guided ]; then
    DISPLAY=:0 /usr/bin/kazeta-guided >/dev/null 2>&1 &
fi

# Set default HDMI audio only if the user hasn't set a preference.
if [ ! -e /var/kazeta/state/.AUDIO_PREFERENCE_SET ]; then
	for i in $(seq 1 60); do
		sink_id=$(wpctl status --name | grep output | grep hdmi | head -1 | grep -oE " [0-9]+\. " | tr -d ' .')
		if [ -n "$sink_id" ]; then
			wpctl set-default $sink_id
			if [ "$?" == "0" ]; then
				wpctl set-volume $sink_id 0.8
				break
			fi
		fi
		sleep 1
	done
fi

# Wait for the BIOS process to exit. Must target the BIOS pid specifically —
# a bare `wait` would also block on the guide daemon, which never exits.
wait "$BIOS_PID"

# After the BIOS quits, check if it wants to restart or shut down.
RESTART_SESSION_SENTINEL="/var/kazeta/state/.RESTART_SESSION_SENTINEL"
if [ -f "$RESTART_SESSION_SENTINEL" ]; then
    rm -f "$RESTART_SESSION_SENTINEL"
    # Use exec here to replace the current process cleanly.
    exec kazeta-session
else
    # If no sentinel is found, shut down the system.
    poweroff
fi
